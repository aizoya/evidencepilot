# Inject these through your environment/hosting secret manager. Never commit .env.
NEBIUS_API_KEY=
TAVILY_API_KEY=
# Select an available text model in your Token Factory account; no assumed model.
NEBIUS_MODEL=
# Generate securely: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
APP_ACCESS_TOKEN=
APP_ORIGIN=http://127.0.0.1:8000
# Enable only after explicit authorization of the provider accounts and budget.
ENABLE_LIVE_RESEARCH=false
DAILY_RUN_LIMIT=10
QUOTA_DB=quota.sqlite3
